{
  "include": ["src/**/*", "typings/**/*"],

  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "lib": ["esnext"],
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "importHelpers": true,
    "skipLibCheck": true
  }
}

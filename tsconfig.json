{
  "include": ["src/**/*", "typings/**/*"],

  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "lib": ["esnext"],
    "rootDir": "./src",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "skipLibCheck": true
  }
}

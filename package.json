{
  "name": "react-docgen-typescript-plugin",
  "version": "1.0.8",
  "description": "A webpack plugin to inject react typescript docgen information.",
  "license": "MIT",
  "repository": "hipstersmoothie/react-docgen-typescript-plugin",
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts",
    "start": "yarn build --watch",
    "lint": "eslint src --ext .ts,.js",
    "test": "jest",
    "release": "auto shipit"
  },
  "keywords": [
    "react",
    "docgen",
    "typescript",
    "webpack",
    "plugin"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "debug": "^4.1.1",
    "find-cache-dir": "^3.3.1",
    "flat-cache": "^3.0.4",
    "micromatch": "^4.0.2",
    "react-docgen-typescript": "^2.4.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.5",
    "@types/find-cache-dir": "^3.2.0",
    "@types/flat-cache": "^2.0.0",
    "@types/jest": "^29.5.12",
    "@types/micromatch": "^4.0.1",
    "@types/node": "^25.0.3",
    "@types/react": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "auto": "^11.1.1",
    "auto-config-hipstersmoothie": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-xo": "^0.44.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "react": "^17.0.1",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.1.2",
    "tsup": "^8.5.1",
    "typescript": "5.4.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "yarn-add-no-save": "^1.0.3"
  },
  "peerDependencies": {
    "typescript": ">= 5.x",
    "webpack": ">= 5"
  },
  "lint-staged": {
    "*.{js,css,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "auto": {
    "extends": "hipstersmoothie"
  },
  "packageManager": "yarn@4.12.0"
}
